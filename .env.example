# Optional. docker compose up -d works without this file.
# Copy to .env only if you want to override the defaults.

HOST_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
CRM_API_PORT=4000
CRM_FRONTEND_PORT=8100
MONGO_PORT=27017

WEB_PUBLIC_URL=http://localhost:3000
CRM_PUBLIC_URL=http://localhost:8100
CRM_PUBLIC_API_URL=http://localhost:4000/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8100,http://127.0.0.1:3000,http://127.0.0.1:8100

CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=admin123
JWT_SECRET=homo-local-development-secret-change-before-production
