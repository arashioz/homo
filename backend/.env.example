NODE_ENV=development
PORT=4000
API_PREFIX=v1
# Local Docker MongoDB. Match the username/password/database in infra/.env.
MONGODB_URI=mongodb://homo_admin:replace-with-your-mongo-password@127.0.0.1:27017/homo?authSource=admin&replicaSet=rs0
CORS_ORIGINS=http://localhost:3000,http://localhost:8100
JWT_SECRET=replace-with-a-long-random-secret
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=replace-with-a-strong-password
SITE_PUBLIC_URL=http://localhost:3000
AI_PROVIDER=none
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
