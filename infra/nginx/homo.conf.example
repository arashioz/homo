# Replace the example domains and certificate paths before enabling this file.
# The Compose ports bind to 127.0.0.1 by default, so only this proxy is public.

upstream homo_web {
  server 127.0.0.1:3000;
  keepalive 32;
}

upstream homo_crm_api {
  server 127.0.0.1:4000;
  keepalive 32;
}

upstream homo_crm_frontend {
  server 127.0.0.1:8100;
  keepalive 32;
}

server {
  listen 80;
  listen [::]:80;
  server_name homo.example.com crm.example.com api.crm.example.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name homo.example.com;

  # Configure these with Certbot or your certificate provider.
  ssl_certificate /etc/letsencrypt/live/homo.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/homo.example.com/privkey.pem;
  client_max_body_size 30m;

  location / {
    proxy_pass http://homo_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name api.crm.example.com;

  ssl_certificate /etc/letsencrypt/live/api.crm.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api.crm.example.com/privkey.pem;

  location / {
    proxy_pass http://homo_crm_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name crm.example.com;

  ssl_certificate /etc/letsencrypt/live/crm.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/crm.example.com/privkey.pem;

  location / {
    proxy_pass http://homo_crm_frontend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
