# Copy this file to infra/.env before production deployment. Do not commit it.
# Use `openssl rand -hex 32` for passwords/secrets so Mongo URI encoding is not needed.

COMPOSE_PROJECT_NAME=homo
# Keep application ports private behind Nginx/Caddy in production. Set to
# 0.0.0.0 only for a short-lived LAN/mobile test protected by a firewall.
HOST_BIND_ADDRESS=127.0.0.1

# MongoDB (used by crm-backend)
MONGO_ROOT_USERNAME=homo_admin
MONGO_ROOT_PASSWORD=replace-with-a-64-character-random-hex-value
MONGO_DATABASE=homo

# CRM backend
CRM_API_PORT=4000
CRM_CORS_ORIGINS=http://localhost:8100,https://crm.example.com
CRM_PUBLIC_API_URL=https://api.crm.example.com/v1
CRM_FRONTEND_PORT=8100
JWT_SECRET=replace-with-a-different-64-character-random-hex-value
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Current website (the public site and its temporary Next.js route handlers)
WEB_PORT=3000
WEB_PUBLIC_URL=https://example.com
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=replace-with-a-strong-web-admin-password
WEB_ADMIN_SESSION_SECRET=replace-with-a-third-64-character-random-hex-value
